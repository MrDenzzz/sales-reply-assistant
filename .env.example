# Любой OpenAI-совместимый сервер: LM Studio, Ollama, OpenAI, OpenRouter и т. п.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen/qwen3.5-9b
# "none" выключает «рассуждения» у гибридных моделей (Qwen3.5, Gemma 4) — ответ в разы быстрее.
# Для облачных моделей, которые не знают этот параметр, оставьте пустым.
LLM_REASONING_EFFORT=none
LLM_TEMPERATURE=0.3

# Эмбеддинги для поиска по базе знаний. По умолчанию — тот же сервер, что и у чат-модели.
EMBEDDING_MODEL=text-embedding-bge-m3
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# База знаний. Свои (непубличные) базы удобно класть в knowledge/private/ — папка в .gitignore.
KNOWLEDGE_BASE_PATH=knowledge/demo.yaml

HOST=127.0.0.1
PORT=8000
